                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test('Access denied message', function () {",
                  "    const response = pm.response.text();",
                  "    pm.expect(response).to.include('Chỉ ADMIN mới có quyền');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🔍 Test Board Creation Issue",
      "item": [
        {
          "name": "1. Create Board as New User (Should work currently)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{newUserToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Board Created by New User\",\n  \"description\": \"This board was created by a new user to test permissions\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/boards",
              "host": ["{{baseUrl}}"],
              "path": ["api", "boards"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 (This shows the permission issue)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Board created successfully', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('id');",
                  "    pm.expect(response).to.have.property('name');",
                  "    pm.expect(response.name).to.eql('Board Created by New User');",
                  "});",
                  "",
                  "console.log('⚠️ This test shows that new users can create boards - this is a permission issue!');"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Check Permissions After Creating Board",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{newUserToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/my-permissions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "my-permissions"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('User now has permissions on the board they created', function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.totalBoards).to.be.at.least(1);",
                  "    pm.expect(response.permissions).to.have.length.at.least(1);",
                  "    ",
                  "    const boardPermission = response.permissions[0];",
                  "    pm.expect(boardPermission.role).to.eql('ADMIN');",
                  "    pm.expect(boardPermission.canManageBoard).to.be.true;",
                  "    pm.expect(boardPermission.canViewBoard).to.be.true;",
                  "});",
                  "",
                  "console.log('✅ User automatically got ADMIN role on the board they created');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🔧 Test Authentication",
      "item": [
        {
          "name": "1. Test Auth with Admin Token",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
